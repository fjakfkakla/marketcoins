# Copier en .env.local pour le dev.
# En production : Railway → ton service → Variables. C'est le SEUL endroit : une variable changée
# dans Railway redéploie le site toute seule. Pas de Vercel, pas d'autre hébergeur.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement, ne jamais exposer
SUPABASE_SERVICE_ROLE_KEY=

# Signature des cookies de session. Obligatoire en production : openssl rand -hex 32
SESSION_SECRET=
# Adresse(s) publique(s) du site, séparées par des virgules. Le domaine *.up.railway.app est accepté d'office.
APP_URL=
# devnet (défaut) ou mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Dépôts USDC (Solana)
ALCHEMY_API=
# Adresse publique du coffre
VAULT_ADDRESS=
# Clé privée du wallet qui paie les frais réseau (quelques SOL seulement). Secret.
FEE_PAYER_SECRET_KEY=
# Signing key du webhook Alchemy « Address Activity » sur le coffre. Secret.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Facultatif : protège /api/cron/sync (lancer les tâches à la main) : openssl rand -hex 16
CRON_SECRET=

# Défis : PnL des KOLs (solanatracker.io → Data API, offre gratuite). Secret.
SOLANATRACKER_API_KEY=
# Planificateur intégré (toutes les 10 min) : on par défaut sur Railway, off ailleurs
# SCHEDULER=on
# Wallets autorisés sur /admin (adresses publiques, séparées par des virgules)
ADMIN_WALLETS=

